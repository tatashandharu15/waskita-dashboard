{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "bash -c 'mkdir -p assets && true',
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
